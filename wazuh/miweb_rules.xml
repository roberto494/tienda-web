<group name="miweb,web,">
  <rule id="100300" level="0">
    <decoded_as>json</decoded_as>
    <field name="app">^miweb$</field>
    <description>miweb: evento HTTP de laboratorio</description>
  </rule>
  <rule id="100301" level="5">
    <if_sid>100300</if_sid>
    <status>^404$</status>
    <description>miweb: ruta inexistente $(ruta) desde $(ip)</description>
    <group>miweb_http404,</group>
  </rule>
  <rule id="100302" level="6">
    <if_sid>100300</if_sid>
    <status>^403$</status>
    <description>miweb: acceso denegado $(ruta) desde $(ip)</description>
    <group>miweb_http403,</group>
  </rule>
  <rule id="100303" level="9" frequency="5" timeframe="60">
    <if_matched_sid>100301</if_matched_sid>
    <same_field>ip</same_field>
    <description>miweb: repeticion de 404 desde la misma IP en 60 segundos</description>
    <group>miweb_recon,</group>
  </rule>
</group>
