# Copia este archivo a .env y sustituye TODOS los valores.
# Genera contraseñas con:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# .env NUNCA se sube a Git ni se entrega.

MYSQL_ROOT_PASSWORD=cambia_esto_root
MYSQL_DATABASE=nexobit
MYSQL_USER=nexobit_app
MYSQL_PASSWORD=cambia_esto_app

# Cuenta de administrador que se crea automáticamente al arrancar
# (solo si no existe). Contraseña de 12 caracteres como mínimo.
ADMIN_USER=admin
ADMIN_EMAIL=admin@nexobit.test
ADMIN_PASSWORD=cambia_esto_admin

APP_ENV=lab
